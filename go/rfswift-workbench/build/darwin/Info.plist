<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the macOS bundle produced by `wails build`
  (make darwin_*). Wails renders it as a Go template with the project
  data from wails.json (name, info.productName, ...). Without it Wails falls
  back to its default template, whose bundle identifier is
  com.wails.<name>; a Developer ID signed / notarized app must carry a
  PentHertz identifier instead (Gatekeeper, TCC and the Keychain all key
  on it). CFBundleShortVersionString / CFBundleVersion are stamped with
  the release version by .github/workflows/macos-dmg.yml after the build.
-->
<plist version="1.0">
<dict>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>{{.Info.ProductName}}</string>
	<key>CFBundleDisplayName</key>
	<string>{{.Info.ProductName}}</string>
	<key>CFBundleExecutable</key>
	<string>{{.OutputFilename}}</string>
	<key>CFBundleIdentifier</key>
	<string>com.penthertz.rfswift-workbench</string>
	<key>CFBundleVersion</key>
	<string>{{.Info.ProductVersion}}</string>
	<key>CFBundleShortVersionString</key>
	<string>{{.Info.ProductVersion}}</string>
	<key>CFBundleGetInfoString</key>
	<string>{{.Info.Comments}}</string>
	<key>CFBundleIconFile</key>
	<string>iconfile</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- Go 1.23+ binaries require macOS 11 or later on both slices. -->
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>{{.Info.Copyright}}</string>
</dict>
</plist>
