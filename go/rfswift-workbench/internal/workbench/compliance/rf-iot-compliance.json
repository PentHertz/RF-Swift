{
 "note": "Starting point for reports, not a conformity assessment: confirm every requirement against the edition of the standard you assess against, and the Official Journal citation of EN 18031 (it lists restrictions).",
 "frameworks": [
  {
   "id": "en18031",
   "short": "EN 18031",
   "name": "EN 18031-1/-2/-3:2024 (EU Radio Equipment Directive, Article 3(3)(d)(e)(f))",
   "note": "Harmonised standards for the RED delegated act (Regulation (EU) 2022/30), applicable since 1 August 2025. Part 1: internet-connected radio equipment (network protection). Part 2: radio equipment processing personal data, toys and childcare equipment and wearables (privacy). Part 3: internet-connected radio equipment processing virtual money or monetary value (fraud). Requirements are grouped by security mechanism; the mechanism applies in every part that covers the equipment.",
   "requirements": {
    "ACM": "Access control mechanism",
    "AUM": "Authentication mechanism",
    "SUM": "Secure update mechanism",
    "SSM": "Secure storage mechanism",
    "SCM": "Secure communication mechanism",
    "RLM": "Resilience mechanism",
    "NMM": "Network monitoring mechanism",
    "TCM": "Traffic control mechanism",
    "CCK": "Confidential cryptographic keys",
    "GEC": "General equipment capabilities",
    "CRY": "Cryptography",
    "LGM": "Logging mechanism (part 2, part 3)",
    "DLM": "Deletion mechanism (part 2)",
    "UNM": "User notification mechanism (part 2)"
   }
  },
  {
   "id": "etsi303645",
   "short": "ETSI EN 303 645",
   "name": "ETSI EN 303 645 (Cyber security for consumer IoT: baseline requirements)",
   "note": "Provision groups of clauses 5 and 6. Also the basis of the UK PSTI product security regime and of many IoT certification schemes.",
   "requirements": {
    "5.1": "No universal default passwords",
    "5.2": "Implement a means to manage reports of vulnerabilities",
    "5.3": "Keep software updated",
    "5.4": "Securely store sensitive security parameters",
    "5.5": "Communicate securely",
    "5.6": "Minimize exposed attack surfaces",
    "5.7": "Ensure software integrity",
    "5.8": "Ensure that personal data is secure",
    "5.9": "Make systems resilient to outages",
    "5.10": "Examine system telemetry data",
    "5.11": "Make it easy for users to delete user data",
    "5.12": "Make installation and maintenance of devices easy",
    "5.13": "Validate input data",
    "6": "Data protection provisions for consumer IoT"
   }
  },
  {
   "id": "owaspiot",
