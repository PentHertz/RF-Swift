# Compiled rfswift binary. Anchored with a leading slash so it matches ONLY the
# built executable, not the go/rfswift/ source directory (a bare "rfswift"
# pattern silently ignored every new file added under go/rfswift/).
/rfswift
/go/rfswift/rfswift

# macOS Finder metadata, in any directory.
.DS_Store

# Windows installer build outputs (WiX MSI + Burn bundle). The .wxs/.wxl/theme
# sources and build.ps1 are tracked; everything generated at build time is not.
/windows/installer/build/
/windows/installer/obj/
/windows/installer/**/*.wixobj
/windows/installer/**/*.wixpdb
/windows/installer/License.rtf
/windows/installer/**/*.msi
/windows/installer/**/*.exe
